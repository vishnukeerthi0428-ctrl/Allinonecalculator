# backend.env.example (dev, IN) — non-secret values only; secrets are *_REF ARNs resolved at start (Part 11.24 §11.24.5)
APP_PRODUCT=commercial
APP_ENV=dev
WEBSITE_ORIGIN=none
ADMIN_ORIGIN=none
OAUTH_ISSUER=none
WEBSITE_AUDIENCE=none
ADMIN_AUDIENCE=none
DATABASE_SECRET_REF=arn:aws:secretsmanager:ap-south-1:<account>:secret:/growth/dev/in/database_secret_ref
WORKER_DATABASE_SECRET_REF=arn:aws:secretsmanager:ap-south-1:<account>:secret:/growth/dev/in/worker_database_secret_ref
BROKER_SECRET_REF=arn:aws:secretsmanager:ap-south-1:<account>:secret:/growth/dev/in/broker_secret_ref
OBJECT_STORE_REF=growth-{env}-{zone}-objects
VECTOR_STORE_REF=vec
AUTOMATION_ENABLED=false
EXTERNAL_DISPATCH_ENABLED=false
PAID_FALLBACK_ENABLED=false
PROVIDER_TIMEOUTS=5 / 20
RETRY_POLICY=3, 30 s, 2, 15 min
LOG_LEVEL=INFO (prod)
OTEL_EXPORTER_OTLP_ENDPOINT=collector sidecar
LOG_REDACTION_POLICY=current approved
ALERT_DESTINATIONS=none
MAX_REQUEST_BYTES=ADR-035, NFR-022
ALLOWED_HOSTS=none
WORKER_QUEUE_PREFIX=commercial.{env}.{zone}.
RECOVERY_TARGETS=RC-1 15 min/4 h; growth 15 min/120 min; RC-2 24 h/8 h
ZONE=IN
AWS_REGION=ap-south-1
SUPABASE_PROJECT_REF=per env and zone
SUPABASE_MIGRATOR_SECRET_REF=arn:aws:secretsmanager:ap-south-1:<account>:secret:/growth/dev/in/supabase_migrator_secret_ref
SUPABASE_SERVICE_ROLE_REF=arn:aws:secretsmanager:ap-south-1:<account>:secret:/growth/dev/in/supabase_service_role_ref
VERCEL_FUNCTION_REGION=by ZONE
API_ORIGIN=https://api.{zone}.{domain}
KMS_KEY_ALIAS=per purpose
SES_CONFIGURATION_SET=growth-{env}-{zone}
MODEL_PROVIDER_SECRET_REFS=arn:aws:secretsmanager:ap-south-1:<account>:secret:/growth/dev/in/model_provider_secret_refs
AI_BUDGET_CEILINGS_INR=3000 / 12000 / 40000
MESSAGING_WINDOW_LOCAL=09:00–21:00
BENCH_PEPPER_REF=arn:aws:secretsmanager:ap-south-1:<account>:secret:/growth/dev/in/bench_pepper_ref
WEBHOOK_SIGNING_KEY_REF=arn:aws:secretsmanager:ap-south-1:<account>:secret:/growth/dev/in/webhook_signing_key_ref
OAUTH_TOKEN_SIGNING_KEY_REF=arn:aws:secretsmanager:ap-south-1:<account>:secret:/growth/dev/in/oauth_token_signing_key_ref
SCIM_BASE_URL=https://api.{zone}.{domain}/scim/v2
PSP_SECRET_REFS=arn:aws:secretsmanager:ap-south-1:<account>:secret:/growth/dev/in/psp_secret_refs
VOICE_CPAAS_SECRET_REFS=arn:aws:secretsmanager:ap-south-1:<account>:secret:/growth/dev/in/voice_cpaas_secret_refs
DLT_AGGREGATOR_SECRET_REF=arn:aws:secretsmanager:ap-south-1:<account>:secret:/growth/dev/in/dlt_aggregator_secret_ref
SENTRY_DSN=arn:aws:secretsmanager:ap-south-1:<account>:secret:/growth/dev/in/sentry_dsn
STATUS_PAGE_COMPONENT_IDS=none
FEATURE_FLAG_SOURCE=db
DR_RPO_TARGET_S=900 / 120
DR_LAG_WARN_S=300 / 600 / 900
WALG_ARCHIVE_TIMEOUT_S=60 / 35
BUILD_SHA=set by CI
